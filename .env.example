# =============================================================================
# ShapeShyft MCP Server Environment Variables
# =============================================================================
# Every value here is optional: the server also reads the same settings from
# ~/.shapeshyft/config.json. An environment variable, when non-empty, wins over the
# stored config file.
# =============================================================================

# -----------------------------------------------------------------------------
# API Endpoint (Optional)
# -----------------------------------------------------------------------------
# Base URL of the ShapeShyft API (default: https://api.shapeshyft.ai)
SHAPESHYFT_API_URL=

# -----------------------------------------------------------------------------
# Credentials (at least one required for anything beyond docs/health)
# -----------------------------------------------------------------------------
# Personal API key — https://shapeshyft.ai Dashboard -> Settings -> Personal API Keys
SHAPESHYFT_API_KEY=

# Entity (workspace) API key, for workspace-scoped administration
SHAPESHYFT_ENTITY_API_KEY=

# Project API key, for invoking a single project's endpoints
SHAPESHYFT_PROJECT_API_KEY=

# Firebase ID token, as an alternative to an API key
SHAPESHYFT_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Defaults (Optional)
# -----------------------------------------------------------------------------
# Default entity slug used when a tool call omits one
SHAPESHYFT_ENTITY_SLUG=

# Default organization path used when building AI endpoint URLs
SHAPESHYFT_ORG_PATH=

# -----------------------------------------------------------------------------
# Config File Location (Optional)
# -----------------------------------------------------------------------------
# Override the path of the stored config file
# Default: ~/.shapeshyft/config.json
SHAPESHYFT_CONFIG_PATH=
